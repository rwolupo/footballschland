---
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { sanityClient } from '../../../lib/sanity';
import { D1_SEASONS_QUERY } from '../../../lib/queries';

// Live-Fetch: Alle jährlichen D1-Saison-Übersichten aus Sanity, sortiert vom
// jüngsten zum ältesten. Slug-Konvention: `deutsche-talente-d1-<YYYY>`.
// Dadurch wächst der Hub automatisch mit, sobald DD einen neuen Saison-Post
// veröffentlicht — kein Code-Deploy nötig.
type SeasonPost = {
  slug: string;
  title: string;
  description: string;
  pubDate: string;
  updatedDate?: string;
  readTime?: string;
  heroUrl?: string | null;
  totalPlayers?: number;
  positions?: (string | null)[];
  featuredCount?: number;
  bios?: (string | null)[];
};

const seasons = await sanityClient.fetch<SeasonPost[]>(D1_SEASONS_QUERY);
const currentSeason = seasons[0] ?? null;
const archiveSeasons = seasons.slice(1);

// Jahr aus dem Slug extrahieren (deutsche-talente-d1-2026 → "2026")
const yearOf = (slug: string) => slug.match(/(\d{4})$/)?.[1] ?? '';
const formatDate = (iso?: string) => {
  if (!iso) return '';
  const d = new Date(iso);
  return d.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
};

// Kennzahlen aus dem aktuellen Post ziehen — falls Daten nicht vorhanden sind,
// bleiben die Elemente sauber verborgen.
function topPositions(positions?: (string | null)[]): { label: string; count: number }[] {
  if (!positions || positions.length === 0) return [];
  const counts: Record<string, number> = {};
  for (const raw of positions) {
    if (!raw) continue;
    // Positionen im Post kommen z.B. als "DL - Defensive Line", "OL - Offensive Line".
    // Wir nehmen den kurzen Code links vom Bindestrich, sonst den Rohwert.
    const code = raw.split(/[-–—\s]/)[0].trim().toUpperCase();
    if (!code) continue;
    counts[code] = (counts[code] || 0) + 1;
  }
  return Object.entries(counts)
    .map(([label, count]) => ({ label, count }))
    .sort((a, b) => b.count - a.count)
    .slice(0, 4);
}

function countPodcastGuests(bios?: (string | null)[]): number {
  if (!bios || bios.length === 0) return 0;
  const re = /S\d{1,2}E\d{1,3}/i;
  return bios.filter((b) => b && re.test(b)).length;
}

const stats = currentSeason
  ? {
      total: currentSeason.totalPlayers ?? 0,
      featured: currentSeason.featuredCount ?? 0,
      podcastGuests: countPodcastGuests(currentSeason.bios),
      topPos: topPositions(currentSeason.positions),
    }
  : null;

// SEO / JSON-LD
const canonicalUrl = 'https://footballschland.de/guides/deutsche-im-college-football/';
const pageTitle = 'Deutsche im College Football: Der Guide-Hub';
const pageDescription =
  'Alle deutschen Spieler in den D1-Colleges (FBS + FCS) – jede Saison mit Namen, Positionen und Programmen. Aktuelle Saison plus Archiv aller vergangenen Jahrgänge.';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalUrl}#collection`,
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  inLanguage: 'de',
  isPartOf: { '@id': 'https://footballschland.de/#website' },
  publisher: { '@id': 'https://footballschland.de/#organization' },
  hasPart: seasons.map((s) => ({
    '@type': 'Article',
    headline: s.title,
    url: `https://footballschland.de/blockblog/${s.slug}/`,
    datePublished: s.pubDate,
    ...(s.updatedDate ? { dateModified: s.updatedDate } : {}),
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://footballschland.de/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://footballschland.de/guides/' },
    { '@type': 'ListItem', position: 3, name: 'Deutsche im College Football' },
  ],
};

// Evergreen-FAQ — saisonsübergreifend gültig, kein Saison-Copy
const faqs = [
  {
    q: 'Was ist der Unterschied zwischen FBS und FCS?',
    a: 'Beide gehören zur NCAA Division 1. Die FBS (Football Bowl Subdivision) ist die höhere Ebene: mehr Stipendien, größere Stadien, TV-Verträge, am Saisonende die Bowl Games und die College Football Playoffs. Die FCS (Football Championship Subdivision) hat kleinere Kader, weniger Stipendien und spielt ein echtes Playoff-Turnier um den Titel. Für deutsche Spieler ist die FCS oft der realistischere Einstieg — mit der Option, später nach oben zu transferieren.',
  },
  {
    q: 'Wie kommt ein deutscher Spieler an ein US-College?',
    a: 'Es gibt mehrere Wege: über Vermittlungsprogramme wie PPI Recruits oder Gridiron Imports, über die NFL Academy in London, über ein Austauschjahr an einer US-Highschool, über eine Prep School wie die Rabun Gap-Nakoochee School — oder komplett auf eigene Faust mit Highlight-Tape und Kaltakquise. Ausführlich haben wir das im Guide „Dein Weg in die NFL“ beschrieben.',
  },
  {
    q: 'Warum überhaupt College Football für einen deutschen Spieler?',
    a: 'Weil die NCAA Division 1 die zweitbeste Football-Liga der Welt ist — direkt hinter der NFL — und der wichtigste Sprungbrett-Pfad in die NFL. Wer aus Deutschland in die NFL will, kommt fast immer über ein D1-College. Dazu ist College Football für viele auch ohne NFL-Ambition der Weg in ein Studium, das sie sich sonst finanziell nicht leisten könnten.',
  },
  {
    q: 'Wie stellt Footballschland diese Listen zusammen?',
    a: 'Grundlage sind die offiziellen Roster aller 138 FBS- und 128 FCS-Programme, die wir automatisiert auslesen und regelmäßig abgleichen. Ein Spieler kommt nur auf eine Saisonliste, wenn er auf dem aktuellen Roster seines Programms steht und seine deutsche Herkunft belegt ist. Jeder Treffer wird gegengeprüft — Kinder von US-Militärangehörigen, die an DoDEA-Schulen in Ramstein oder Wiesbaden aufgewachsen sind, gehören nicht dazu. Wo eine Spur endet, steht das im jeweiligen Saisontext.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={`${pageTitle} | Footballschland`}
  description={pageDescription}
  canonical={canonicalUrl}
  ogImage={currentSeason?.heroUrl ?? '/assets/og-default.png'}
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <!-- Hero -->
  <section class="bg-[#231f20] pt-32 pb-16 px-4">
    <div class="max-w-3xl mx-auto">
      <nav aria-label="Breadcrumb" class="text-white/40 text-xs font-body mb-6">
        <a href="/" class="hover:text-white">Home</a>
        <span class="mx-2">/</span>
        <a href="/guides/" class="hover:text-white">Guides</a>
        <span class="mx-2">/</span>
        <span class="text-white/70">Deutsche im College Football</span>
      </nav>

      <p class="text-rot text-xs font-bold uppercase tracking-widest mb-3">Guide-Hub</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-white mb-4 leading-tight">
        Deutsche im <span class="text-rot">College Football</span>
      </h1>
      <p class="text-white/70 text-lg font-body leading-relaxed max-w-2xl">
        Jede Saison eine neue Liste, die belegbar ist und ihre Lücken benennt.
        Aktuell und alle vergangenen Jahrgänge – FBS und FCS, Namen, Positionen, Programme.
      </p>
    </div>
  </section>

  <!-- Aktuelle Saison -->
  {currentSeason && (
    <section class="bg-[#faf8f5] py-16 px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs font-bold uppercase tracking-widest text-rot mb-4">
          Aktuelle Saison
        </p>

        <a
          href={`/blockblog/${currentSeason.slug}/`}
          class="group block bg-white rounded-2xl border border-[#231f20]/8 overflow-hidden shadow-sm hover:shadow-lg transition-shadow"
        >
          {currentSeason.heroUrl && (
            <div class="aspect-[16/9] overflow-hidden bg-[#231f20]/10">
              <img
                src={currentSeason.heroUrl}
                alt={`Titelbild: ${currentSeason.title}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="eager"
              />
            </div>
          )}
          <div class="p-8">
            <div class="flex flex-wrap items-center gap-3 mb-4 text-[#231f20]/50 text-sm font-body">
              <span class="px-2.5 py-1 bg-rot/10 text-rot text-xs font-bold uppercase tracking-wider rounded">
                Saison {yearOf(currentSeason.slug)}
              </span>
              <span>Veröffentlicht: {formatDate(currentSeason.pubDate)}</span>
              {currentSeason.readTime && <span>· {currentSeason.readTime}</span>}
            </div>
            <h2 class="font-display text-2xl md:text-3xl font-bold text-[#231f20] group-hover:text-rot transition-colors mb-3 leading-tight">
              {currentSeason.title}
            </h2>
            <p class="text-[#231f20]/70 font-body leading-relaxed mb-5">
              {currentSeason.description}
            </p>
            <span class="inline-flex items-center text-rot font-semibold text-sm group-hover:translate-x-1 transition-transform">
              Zur aktuellen Saison →
            </span>
          </div>
        </a>

        {stats && (stats.total > 0 || stats.featured > 0) && (
          <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-3">
            {stats.total > 0 && (
              <div class="bg-white rounded-xl border border-[#231f20]/8 p-4 text-center">
                <p class="font-display text-3xl font-black text-rot leading-none">{stats.total}</p>
                <p class="text-xs font-semibold text-[#231f20]/60 uppercase tracking-wider mt-1">Spieler</p>
              </div>
            )}
            {stats.featured > 0 && (
              <div class="bg-white rounded-xl border border-[#231f20]/8 p-4 text-center">
                <p class="font-display text-3xl font-black text-[#231f20] leading-none">{stats.featured}</p>
                <p class="text-xs font-semibold text-[#231f20]/60 uppercase tracking-wider mt-1">Porträts</p>
              </div>
            )}
            {stats.podcastGuests > 0 && stats.featured > 0 && (
              <div class="bg-white rounded-xl border border-[#231f20]/8 p-4 text-center">
                <p class="font-display text-3xl font-black text-gold leading-none">{stats.podcastGuests}</p>
                <p class="text-xs font-semibold text-[#231f20]/60 uppercase tracking-wider mt-1">im Podcast</p>
              </div>
            )}
            {stats.topPos.length > 0 && (
              <div class="bg-white rounded-xl border border-[#231f20]/8 p-4 text-center col-span-2 md:col-span-1">
                <p class="font-display text-sm font-bold text-[#231f20] leading-tight">
                  {stats.topPos.slice(0, 3).map((p) => `${p.label} ${p.count}`).join(' · ')}
                </p>
                <p class="text-xs font-semibold text-[#231f20]/60 uppercase tracking-wider mt-1">Top-Positionen</p>
              </div>
            )}
          </div>
        )}

        {stats && stats.podcastGuests > 0 && stats.featured > 0 && (
          <p class="text-sm text-[#231f20]/60 mt-4 text-center font-body">
            <a href="/episoden/" class="text-rot hover:underline">
              {stats.podcastGuests} von {stats.featured} porträtierten Spielern waren im Footballschland-Podcast →
            </a>
          </p>
        )}
      </div>
    </section>
  )}

  <!-- Worum es hier geht (Kurz-Erklärung) -->
  <section class="bg-white py-14 px-4 border-y border-[#231f20]/8">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs font-bold uppercase tracking-widest text-[#231f20]/50 mb-4">
        Worum es hier geht
      </p>
      <p class="text-[#231f20]/80 font-body leading-relaxed text-lg">
        Alle deutschen Spieler in den D1-Colleges — Saison für Saison, seit wir zählen.
        Aktuelle Saison zuerst, dann das Archiv. Grundlage sind die offiziellen Roster aller
        138 FBS- und 128 FCS-Programme, jeder Eintrag gegengeprüft. Wo die Spur endet, sagen
        wir das.
      </p>
    </div>
  </section>

  <!-- Archiv -->
  {archiveSeasons.length > 0 && (
    <section class="bg-[#faf8f5] py-16 px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs font-bold uppercase tracking-widest text-rot mb-2">Archiv</p>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-[#231f20] mb-6">
          Vergangene Saisons
        </h2>
        <div class="space-y-4">
          {archiveSeasons.map((s) => (
            <a
              href={`/blockblog/${s.slug}/`}
              class="group flex flex-col sm:flex-row gap-5 bg-white rounded-2xl border border-[#231f20]/8 p-6 shadow-sm hover:shadow-md transition-shadow"
            >
              {s.heroUrl && (
                <div class="sm:w-40 sm:shrink-0">
                  <div class="aspect-[16/10] rounded-lg overflow-hidden bg-[#231f20]/10">
                    <img
                      src={s.heroUrl}
                      alt={`Titelbild: ${s.title}`}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                </div>
              )}
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-3 mb-2 text-[#231f20]/50 text-xs font-body">
                  <span class="px-2 py-0.5 bg-[#231f20]/10 text-[#231f20]/70 text-[10px] font-bold uppercase tracking-wider rounded">
                    Saison {yearOf(s.slug)}
                  </span>
                  <span>{formatDate(s.pubDate)}</span>
                  {s.readTime && <span>· {s.readTime}</span>}
                </div>
                <h3 class="font-display text-lg font-bold text-[#231f20] group-hover:text-rot transition-colors mb-2 leading-snug">
                  {s.title}
                </h3>
                <p class="text-[#231f20]/65 font-body text-sm leading-relaxed line-clamp-3">
                  {s.description}
                </p>
              </div>
              <div class="hidden sm:flex items-center text-rot font-semibold text-sm group-hover:translate-x-1 transition-transform shrink-0 self-center">
                →
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Evergreen-FAQ -->
  <section class="bg-white py-16 px-4 border-t border-[#231f20]/8">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs font-bold uppercase tracking-widest text-rot mb-2">Häufige Fragen</p>
      <h2 class="font-display text-2xl md:text-3xl font-bold text-[#231f20] mb-6">
        Was ist College Football, und wie kommt man da hin?
      </h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-xl border border-[#231f20]/10 bg-[#faf8f5]/50 open:bg-white transition-colors">
            <summary class="cursor-pointer list-none px-5 py-4 flex items-start justify-between gap-4">
              <h3 class="font-display font-bold text-[#231f20] text-base leading-snug">{f.q}</h3>
              <span class="text-rot text-xl leading-none shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="px-5 pb-5 text-[#231f20]/75 font-body text-sm leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-Sell zu verwandten Guides -->
  <section class="bg-[#faf8f5] py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs font-bold uppercase tracking-widest text-rot mb-2">Verwandte Guides</p>
      <h2 class="font-display text-2xl md:text-3xl font-bold text-[#231f20] mb-6">
        Wenn dich College Football interessiert, gehören diese auch dazu
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a
          href="/weg-in-die-nfl/"
          class="group flex flex-col justify-between bg-white rounded-2xl border border-[#231f20]/8 p-6 shadow-sm hover:shadow-md transition-shadow min-h-[180px]"
        >
          <div>
            <span class="inline-block text-xs font-bold uppercase tracking-widest text-rot mb-2">NFL Karriere</span>
            <h3 class="font-display text-lg font-bold text-[#231f20] group-hover:text-rot transition-colors leading-snug mb-2">
              Dein Weg in die NFL: Guide für deutsche Talente
            </h3>
            <p class="text-[#231f20]/60 font-body text-sm leading-relaxed">
              Alle sechs Karrierewege — vom IPP über NCAA bis zum direkten Draft aus Europa.
            </p>
          </div>
          <span class="text-rot font-semibold text-sm mt-3 group-hover:translate-x-1 transition-transform">
            Zum Guide →
          </span>
        </a>

        <a
          href="/nfl-draft/"
          class="group flex flex-col justify-between bg-white rounded-2xl border border-[#231f20]/8 p-6 shadow-sm hover:shadow-md transition-shadow min-h-[180px]"
        >
          <div>
            <span class="inline-block text-xs font-bold uppercase tracking-widest text-rot mb-2">NFL Draft</span>
            <h3 class="font-display text-lg font-bold text-[#231f20] group-hover:text-rot transition-colors leading-snug mb-2">
              NFL Draft erklärt: Ablauf, Runden & deutsche Spieler
            </h3>
            <p class="text-[#231f20]/60 font-body text-sm leading-relaxed">
              Wie der Draft funktioniert, Combine, Pro Days — und alle Deutschen, die je gedraftet wurden.
            </p>
          </div>
          <span class="text-rot font-semibold text-sm mt-3 group-hover:translate-x-1 transition-transform">
            Zum Guide →
          </span>
        </a>
      </div>

      <div class="mt-6 text-center">
        <a
          href="/guides/"
          class="inline-block text-sm text-[#231f20]/60 hover:text-rot font-body transition-colors"
        >
          ← Alle Guides
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
